<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Enumerate the device's callable PhoneAccounts (diagnostic). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Reserved for future self-managed / placeCall paths. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Required to fire ACTION_CALL at Google Voice to place the VoIP call. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Launch Google Voice over the lockscreen when the phone is locked/asleep. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility: needed to see / launch Google Voice. -->
    <queries>
        <package android:name="com.google.android.apps.googlevoice" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="SouthJack"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".DiagnosticActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android hands every outgoing call to this service so we can re-route it
             to Google Voice. Requires the app to hold the CALL_REDIRECTION role. -->
        <service
            android:name=".RedirectionService"
            android:exported="true"
            android:permission="android.permission.BIND_CALL_REDIRECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallRedirectionService" />
            </intent-filter>
        </service>

    </application>
</manifest>
